<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.3.0.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="AngleSharp" Version="1.8.3" />
    <PackageReference Include="UTF.Unknown" Version="2.7.0" />
    <EmbeddedResource Include="../../webui/dist/*.js" LogicalName="SubtitlesTool.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Configuration/configPage.html" LogicalName="SubtitlesTool.Configuration" />
  </ItemGroup>
</Project>
